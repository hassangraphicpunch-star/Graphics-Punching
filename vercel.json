{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "graphics-punching.vercel.app"
        }
      ],
      "destination": "https://www.graphicspunching.com/$1",
      "permanent": true
    },
    {
      "source": "/((?!favicon|apple-touch|logo|site\\.webmanifest|robots\\.txt|sitemap\\.xml).*)",
      "has": [
        {
          "type": "host",
          "value": "graphicspunching.com"
        }
      ],
      "destination": "https://www.graphicspunching.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(ico|png|jpg|jpeg|svg|webp)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.*|logo.*|apple-touch-icon.*|site\\.webmanifest)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
